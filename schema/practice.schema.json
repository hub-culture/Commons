{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hub-culture/Commons/schema/practice.schema.json",
  "title": "Commons practice",
  "description": "A reusable way of doing something well in a commons, with where it has worked and the evidence. Practices migrate between commons and Cloud Mirror spokes. See docs/blue-carbon-registry.md.",
  "type": "object",
  "required": ["id", "name", "family", "part", "summary", "evidence", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "family": { "type": "string", "description": "e.g. mpa-governance, blue-carbon-mrv, benefit-sharing, agent-governance" },
    "part": {
      "enum": ["boundaries", "terms", "rules", "rights", "responsibilities", "remuneration", "monitoring", "method"],
      "description": "Which part of commons infrastructure (framework section 3) the practice serves; monitoring and method cover measurement and process."
    },
    "commons_kinds": { "type": "array", "items": { "type": "string" }, "description": "Kinds of commons it applies to (as in commons.schema.json)." },
    "summary": { "type": "string" },
    "how": { "type": "array", "items": { "type": "string" }, "description": "The steps, briefly." },
    "worked_in": { "type": "array", "items": { "type": "string" }, "description": "Places or commons where it has been used, with outcome." },
    "limits": { "type": "array", "items": { "type": "string" } },
    "ostrom_principles": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 8 } },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["citation"],
        "properties": { "citation": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
      }
    },
    "status": { "enum": ["candidate", "adopted", "retired"] }
  }
}
