{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hub-culture/Commons/schema/commons.schema.json",
  "title": "Commons registry entry",
  "description": "One commons, placed on the rules ladder, in the shape a Gaia map layer and a Cloud Mirror charter can use.",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "ladder_step",
    "boundaries",
    "users",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "ocean",
        "land",
        "freshwater",
        "atmosphere",
        "biodiversity",
        "genetic-resources",
        "energy",
        "space",
        "digital",
        "agents",
        "knowledge",
        "other"
      ]
    },
    "ladder_step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "1 = no rules, 2 = weak rules, 3 = rules that don't pay out. Use 4 only when a commons is protected and remunerating; omitted for now."
    },
    "summary": {
      "type": "string"
    },
    "boundaries": {
      "type": "object",
      "description": "Where the commons starts and stops.",
      "properties": {
        "type": {
          "enum": [
            "polygon",
            "network",
            "global",
            "orbital",
            "undefined"
          ]
        },
        "geojson": {
          "type": [
            "object",
            "null"
          ],
          "description": "GeoJSON geometry when the boundary is a place."
        },
        "h3_cells": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "indicative_point": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[longitude, latitude] of an indicative location, for map display before a real boundary exists. Not a boundary and not a claim."
        }
      },
      "required": [
        "type"
      ]
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key definitions and what they include or exclude."
    },
    "users": {
      "type": "object",
      "properties": {
        "inliers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outliers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "opponents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Those who don't want a commons here. They define the boundary from the other side."
        },
        "seasonal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "instrument": {
            "type": "string"
          },
          "status": {
            "enum": [
              "none",
              "voluntary",
              "binding",
              "binding-unenforced",
              "proposed"
            ]
          },
          "source": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "rights_and_responsibilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "right": {
            "type": "string"
          },
          "responsibility": {
            "type": "string"
          }
        }
      }
    },
    "remuneration": {
      "type": "object",
      "properties": {
        "mechanism": {
          "type": "string"
        },
        "rate": {
          "type": "string"
        },
        "beneficiaries": {
          "type": "string"
        },
        "local_value": {
          "type": "string",
          "description": "What the keepers actually value, and how payouts convert into it."
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cloud_mirror_spoke": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "pilot",
        "active",
        "archived"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "claims": {
      "type": "array",
      "description": "Claims about this commons, each with its evidence, following the Bermuda Standard's five rules (provenance, lineage, agreement, licence and consent, signature). A claim is settled only when enough independent lineages agree; repeating one source adds nothing.",
      "items": {
        "type": "object",
        "required": [
          "statement",
          "status",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "statement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "unverified",
              "settled",
              "contested",
              "refuted"
            ],
            "description": "unverified: fewer independent lineages than the rule needs. settled: enough agree. contested: lineages disagree (kept as evidence). refuted: the evidence goes against it (kept on record)."
          },
          "min_lineages": {
            "type": "integer",
            "minimum": 2,
            "description": "Independent lineages needed to settle this claim. The Bermuda Standard floor is 2; a community may require more."
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source",
                "lineage",
                "licence",
                "supports"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "description": "Where it comes from: a URL, a dataset, or a named testimony."
                },
                "lineage": {
                  "type": "string",
                  "description": "The independent line this evidence belongs to (for example: community testimony, satellite, government registry, peer-reviewed study). Evidence sharing a lineage counts once."
                },
                "kind": {
                  "enum": [
                    "testimony",
                    "measurement",
                    "model",
                    "registry",
                    "study",
                    "reporting",
                    "other"
                  ]
                },
                "licence": {
                  "type": "string",
                  "description": "Licence or terms of use, or 'unknown'."
                },
                "consent": {
                  "type": "string",
                  "description": "For testimony and community data: whose consent, and for what use."
                },
                "signature": {
                  "type": "string",
                  "description": "Optional signature or hash binding the evidence as recorded."
                },
                "supports": {
                  "type": "boolean",
                  "description": "true if it supports the statement, false if it contradicts it."
                }
              }
            }
          }
        }
      }
    }
  }
}
